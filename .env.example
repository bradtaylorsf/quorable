# quorable — copy to .env for local development, or let `quorable keys set`
# manage ~/.quorable/.env (chmod 600) for normal use.
#
# Process environment always wins over ~/.quorable/.env.

# One key, every vendor. This is the only one most people need.
OPENROUTER_API_KEY=

# Direct vendor keys, used when a model id is prefixed `anthropic:` / `openai:`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Fallback key for named OpenAI-compatible endpoints that do not declare
# their own `api_key_env`. Local servers usually need no key at all.
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides. These beat config files and are beaten by CLI flags.
# ---------------------------------------------------------------------------
# QUORABLE_CONFIG=./quorable.yaml
# QUORABLE_COUNCIL=general-doc
# QUORABLE_RUBRIC=document
# QUORABLE_RIGOR=standard
# QUORABLE_MODELS=openrouter:model-a,openrouter:model-b
# QUORABLE_SYNTHESIZER=openrouter:model-a
# QUORABLE_HELD_OUT=openrouter:model-c
# QUORABLE_PROFILE=lmstudio
# QUORABLE_LOCAL_BASE_URL=http://localhost:1234/v1
# QUORABLE_HOME=~/.quorable
